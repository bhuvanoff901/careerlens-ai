# Copy to .env.local. Keep provider and Supabase secrets out of source control.

# Optional. Without a key, analysis uses the clearly labeled local text-cue preview.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Supabase Auth + PostgreSQL persistence.
# Use your project's public anon/publishable key only; never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
